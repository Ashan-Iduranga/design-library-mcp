old\">Yancy Tear</div>\n              <div class=\"text-sm opacity-50\">Brazil</div>\n            </div>\n          </div>\n        </td>\n        <td>\n          Wyman-Ledner\n          <br />\n          <span class=\"badge badge-ghost badge-sm\">Community Outreach Specialist</span>\n        </td>\n        <td>Indigo</td>\n        <th>\n          <button class=\"btn btn-ghost btn-xs\">details</button>\n        </th>\n      </tr>\n    </tbody>\n    <!-- foot -->\n    <tfoot>\n      <tr>\n        <th></th>\n        <th>Name</th>\n        <th>Job</th>\n        <th>Favorite Color</th>\n        <th></th>\n      </tr>\n    </tfoot>\n  </table>\n</div>",
