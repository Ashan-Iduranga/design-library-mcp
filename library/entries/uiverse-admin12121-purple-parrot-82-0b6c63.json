r(--bg-color);\n  border-radius: 50%;\n  transition: opacity 0.3s ease-out;\n}\n\n.circle svg {\n  z-index: 10000;\n  transform: translateZ(0);\n}\n\n.overlay {\n  width: 118px;\n  position: absolute;\n  height: 118px;\n  border-radius: 50%;\n  background: var(--bg-color);\n  top: 70px;\n  left: 50px;\n  z-index: 0;\n  transition: transform 0.3s ease-out;\n}\n</style>",
