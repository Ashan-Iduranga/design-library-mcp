ll: #e8e8e8;\n}\n\n@keyframes shake {\n  0% {\n    rotate: 0deg;\n  }\n\n  33% {\n    rotate: 10deg;\n  }\n\n  66% {\n    rotate: -10deg;\n  }\n\n  100% {\n    rotate: 10deg;\n  }\n}\n\n</style>",
