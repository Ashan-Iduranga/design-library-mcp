  "code": "<div class=\"mx-auto max-w-md space-y-6 p-6\">\n<div aria-labelledby=\"UpdatingLabel\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"25\" role=\"progressbar\">\n<div class=\"flex justify-between gap-4\">\n<span class=\"text-sm font-medium text-gray-900\" id=\"UpdatingLabel\">Updating</span>\n<span class=\"text-sm font-medium text-gray-900\">25%</span>\n</div>\n<div class=\"mt-2 h-2 w-full rounded-full bg-gray-200\">\n<div class=\"h-full rounded-full bg-blue-600\" style=\"width: 25%\"></div>\n</div>\n</div>\n<div aria-labelledby=\"DownloadingLabel\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"100\" role=\"progressbar\">\n<div class=\"flex justify-between gap-4\">\n<span class=\"text-sm font-medium text-gray-900\" id=\"DownloadingLabel\">Downloading</span>\n<span class=\"text-sm font-medium text-gray-900\">100%</span>\n</div>\n<div class=\"mt-2 h-2 w-full rounded-full bg-gray-200\">\n<div class=\"h-full rounded-full bg-green-600\" style=\"width: 100%\"></div>\n</div>\n</div>\n<div aria-labelledby=\"LoadingLabel\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"50\" role=\"progressbar\">\n<div class=\"flex justify-between gap-4\">\n<span class=\"text-sm font-medium text-gray-900\" id=\"LoadingLabel\">Loading</span>\n<span class=\"text-sm font-medium text-gray-900\">50%</span>\n</div>\n<div class=\"mt-2 h-2 w-full rounded-full bg-gray-200\">\n<div class=\"h-full rounded-full bg-gray-600\" style=\"width: 50%\"></div>\n</div>\n</div>\n</div>",
