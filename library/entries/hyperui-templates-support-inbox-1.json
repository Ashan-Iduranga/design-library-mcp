  "code": "<div class=\"flex h-screen flex-col overflow-hidden bg-gray-50\">\n<input class=\"peer sr-only\" id=\"rail-toggle\" type=\"checkbox\"/>\n<header class=\"flex h-14 shrink-0 items-center gap-4 border-b border-gray-200 bg-white px-4 sm:px-6\">\n<label aria-controls=\"queue-rail\" aria-expanded=\"false\" class=\"cursor-pointer rounded-md p-2 text-gray-600 transition hover:bg-gray-100 lg:hidden\" for=\"rail-toggle\" id=\"rail-toggle-label\">\n<span class=\"sr-only\">Toggle queues</span>\n<svg aria-hidden=\"true\" class=\"size-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n</svg>\n</label>\n<p class=\"text-sm font-semibold text-gray-900\">\n        Orbitly <span class=\"font-normal text-gray-400\">/ Support</span>\n</p>\n<label class=\"ml-4 hidden max-w-sm flex-1 sm:block\" for=\"TicketSearch\">\n<span class=\"sr-only\">Search tickets</span>\n<div class=\"relative\">\n<svg aria-hidden=\"true\" class=\"pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-gray-400\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n</svg>\n<input class=\"w-full rounded-md border-gray-200 pl-9 text-sm shadow-xs focus:border-indigo-600 focus:ring-indigo-600\" id=\"TicketSearch\" placeholder=\"Search tickets\" type=\"search\"/>\n</div>\n</label>\n<div class=\"ml-auto flex items-center gap-3\">\n<button class=\"hidden rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-medium text-white transition hover:bg-indigo-700 sm:block\" type=\"button\">\n          New ticket\n        </button>\n<img alt=\"\" class=\"size-8 rounded-full object-cover\" src=\"https://images.unsplash.com/photo-1600486913747-55e5470d6f40?auto=format&amp;fit=crop&amp;q=80&amp;w=200\"/>\n</div>\n</header>\n<div class=\"flex flex-1 overflow-hidden\">\n<label aria-hidden=\"true\" class=\"fixed inset-0 z-30 hidden bg-gray-900/50 peer-checked:block lg:hidden\" for=\"rail-toggle\"></label>\n<nav aria-label=\"Queues\" class=\"fixed inset-y-14 start-0 z-40 w-56 -translate-x-full overflow-y-auto border-e border-gray-200 bg-white p-3 transition-transform duration-300 peer-checked:translate-x-0 lg:static lg:translate-x-0\" id=\"queue-rail\">\n<ul class=\"space-y-1\">\n<li>\n<a class=\"flex items-center justify-between rounded-lg bg-indigo-50 px-3 py-2 text-sm font-medium text-indigo-700\" href=\"#\">\n              My tickets\n              <span class=\"rounded-full bg-white px-2 py-0.5 text-xs text-indigo-700\">4</span>\n</a>\n</li>\n<li>\n<a class=\"flex items-center justify-between rounded-lg px-3 py-2 text-sm text-gray-600 transition hover:bg-gray-100 hover:text-gray-900\" href=\"#\">\n              Unassigned\n              <span class=\"rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600\">11</span>\n</a>\n</li>\n<li>\n<a class=\"flex items-center justify-between rounded-lg px-3 py-2 text-sm text-gray-600 transition hover:bg-gray-100 hover:text-gray-900\" href=\"#\">\n              All open\n              <span class=\"rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600\">37</span>\n</a>\n</li>\n<li>\n<a class=\"flex items-center justify-between rounded-lg px-3 py-2 text-sm text-gray-600 transition hover:bg-gray-100 hover:text-gray-900\" href=\"#\">\n              Closed\n            </a>\n</li>\n</ul>\n<p class=\"mt-6 px-3 text-xs font-medium tracking-wide text-gray-400 uppercase\">Tags</p>\n<ul class=\"mt-2 space-y-1\">\n<li>\n<a class=\"flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-100\" href=\"#\">\n<span class=\"size-2 rounded-full bg-rose-500\"></span>\n              Billing\n            </a>\n</li>\n<li>\n<a class=\"flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-100\" href=\"#\">\n<span class=\"size-2 rounded-full bg-amber-500\"></span>\n              Bug\n            </a>\n</li>\n<li>\n<a class=\"flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-100\" href=\"#\">\n<span class=\"size-2 rounded-full bg-emerald-500\"></span>\n              Onboarding\n            </a>\n</li>\n</ul>\n</nav>\n<main class=\"flex-1 overflow-y-auto\">\n<div class=\"border-b border-gray-200 bg-white px-4 py-4 sm:px-6\">\n<h1 class=\"text-lg font-semibold text-gray-900\">My tickets</h1>\n<div class=\"mt-3 flex gap-1\">\n<button aria-pressed=\"true\" class=\"rounded-md bg-gray-900 px-3 py-1.5 text-xs font-medium text-white\">\n              All\n            </button>\n<button aria-pressed=\"false\" class=\"rounded-md px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-100\">\n              Open\n            </button>\n<button aria-pressed=\"false\" class=\"rounded-md px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-100\">\n              Pending\n            </button>\n<button aria-pressed=\"false\" class=\"rounded-md px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-100\">\n              Closed\n            </button>\n</div>\n</div>\n<div class=\"p-4 sm:p-6\">\n<div class=\"overflow-hidden rounded-lg border border-gray-200 bg-white\">\n<table class=\"min-w-full divide-y divide-gray-200\">\n<thead class=\"bg-gray-50\">\n<tr class=\"*:px-4 *:py-3 *:text-left *:text-xs *:font-medium *:text-gray-500\">\n<th scope=\"col\">Ticket</th>\n<th class=\"hidden sm:table-cell\" scope=\"col\">Requester</th>\n<th scope=\"col\">Status</th>\n<th class=\"hidden md:table-cell\" scope=\"col\">Priority</th>\n<th class=\"hidden md:table-cell\" scope=\"col\">Updated</th>\n</tr>\n</thead>\n<tbody class=\"divide-y divide-gray-200\">\n<tr class=\"cursor-pointer hover:bg-gray-50\">\n<td class=\"px-4 py-3\">\n<p class=\"text-sm font-medium text-gray-900\">Can't export invoices as CSV</p>\n<p class=\"text-xs text-gray-500\">#4821</p>\n</td>\n<td class=\"hidden px-4 py-3 text-sm text-gray-600 sm:table-cell\">Marcus Boyle</td>\n<td class=\"px-4 py-3\">\n<span class=\"rounded-full bg-blue-100 px-2.5 py-0.5 text-xs text-blue-700\">\n                      Open\n                    </span>\n</td>\n<td class=\"hidden px-4 py-3 md:table-cell\">\n<span class=\"rounded-full bg-red-100 px-2.5 py-0.5 text-xs text-red-700\">\n                      High\n                    </span>\n</td>\n<td class=\"hidden px-4 py-3 text-sm text-gray-500 md:table-cell\">\n                    12 minutes ago\n                  </td>\n</tr>\n<tr class=\"cursor-pointer bg-indigo-50/60 hover:bg-indigo-50\">\n<td class=\"px-4 py-3\">\n<p class=\"text-sm font-medium text-gray-900\">\n                      Team seats not syncing after upgrade\n                    </p>\n<p class=\"text-xs text-gray-500\">#4819</p>\n</td>\n<td class=\"hidden px-4 py-3 text-sm text-gray-600 sm:table-cell\">\n                    Priya Natarajan\n                  </td>\n<td class=\"px-4 py-3\">\n<span class=\"rounded-full bg-blue-100 px-2.5 py-0.5 text-xs text-blue-700\">\n                      Open\n                    </span>\n</td>\n<td class=\"hidden px-4 py-3 md:table-cell\">\n<span class=\"rounded-full bg-red-100 px-2.5 py-0.5 text-xs text-red-700\">\n                      High\n                    </span>\n</td>\n<td class=\"hidden px-4 py-3 text-sm text-gray-500 md:table-cell\">\n                    41 minutes ago\n                  </td>\n</tr>\n<tr class=\"cursor-pointer hover:bg-gray-50\">\n<td class=\"px-4 py-3\">\n<p class=\"text-sm font-medium text-gray-900\">\n                      Question about annual billing discount\n                    </p>\n<p class=\"text-xs text-gray-500\">#4812</p>\n</td>\n<td class=\"hidden px-4 py-3 text-sm text-gray-600 sm:table-cell\">\n                    Owen Baptiste\n                  </td>\n<td class=\"px-4 py-3\">\n<span class=\"rounded-full bg-amber-100 px-2.5 py-0.5 text-xs text-amber-700\">\n                      Pending\n                    </span>\n</td>\n<td class=\"hidden px-4 py-3 md:table-cell\">\n<span class=\"rounded-full bg-gray-100 px-2.5 py-0.5 text-xs text-gray-600\">\n                      Low\n                    </span>\n</td>\n<td class=\"hidden px-4 py-3 text-sm text-gray-500 md:table-cell\">3 hours ago</td>\n</tr>\n<tr class=\"cursor-pointer hover:bg-gray-50\">\n<td class=\"px-4 py-3\">\n<p class=\"text-sm font-medium text-gray-900\">\n                      Feature request: dark mode for reports\n                    </p>\n<p class=\"text-xs text-gray-500\">#4790</p>\n</td>\n<td class=\"hidden px-4 py-3 text-sm text-gray-600 sm:table-cell\">\n                    Freya Lindqvist\n                  </td>\n<td class=\"px-4 py-3\">\n<span class=\"rounded-full bg-amber-100 px-2.5 py-0.5 text-xs text-amber-700\">\n                      Pending\n                    </span>\n</td>\n<td class=\"hidden px-4 py-3 md:table-cell\">\n<span class=\"rounded-full bg-gray-100 px-2.5 py-0.5 text-xs text-gray-600\">\n                      Low\n                    </span>\n</td>\n<td class=\"hidden px-4 py-3 text-sm text-gray-500 md:table-cell\">1 day ago</td>\n</tr>\n</tbody>\n</table>\n</div>\n<nav aria-label=\"Pagination\" class=\"mt-4 flex items-center justify-between\">\n<p class=\"text-xs text-gray-500\">Showing 4 of 37 open tickets</p>\n<div class=\"flex gap-1\">\n<a class=\"inline-flex size-8 items-center justify-center rounded-md border border-gray-200 text-gray-400\" href=\"#\">\n<span class=\"sr-only\">Previous</span>\n<svg aria-hidden=\"true\" class=\"size-3 rtl:rotate-180\" fill=\"currentColor\" viewbox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\">\n<path clip-rule=\"evenodd\" d=\"M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z\" fill-rule=\"evenodd\"></path>\n</svg>\n</a>\n<a class=\"inline-flex size-8 items-center justify-center rounded-md border border-gray-200 text-gray-600\" href=\"#\">\n<span class=\"sr-only\">Next</span>\n<svg aria-hidden=\"true\" class=\"size-3 rtl:rotate-180\" fill=\"currentColor\" viewbox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\">\n<path clip-rule=\"evenodd\" d=\"M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z\" fill-rule=\"evenodd\"></path>\n</svg>\n</a>\n</div>\n</nav>\n</div>\n</main>\n</div>\n<script>\n      const railToggleCheckbox = document.getElementById('rail-toggle')\n      const railToggleLabel = document.getElementById('rail-toggle-label')\n\n      railToggleCheckbox.addEventListener('change', () => {\n        railToggleLabel.setAttribute('aria-expanded', String(railToggleCheckbox.checked))\n      })\n    </script>\n</div>",
