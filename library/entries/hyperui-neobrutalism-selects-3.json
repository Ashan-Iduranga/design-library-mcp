  "code": "<div class=\"mx-auto max-w-xs p-6\">\n<label class=\"text-black\" for=\"Headline\">\n<span class=\"text-sm font-semibold\"> Headliner </span>\n<div class=\"relative\">\n<input class=\"mt-0.5 w-full border-2 border-black bg-white placeholder-black shadow-[4px_4px_0_0] shadow-black focus:ring-2 focus:ring-yellow-300 sm:text-sm [&amp;::-webkit-calendar-picker-indicator]:opacity-0\" id=\"Headline\" list=\"HeadlineList\" placeholder=\"Please select\" type=\"text\"/>\n<span class=\"absolute inset-y-0 end-0 grid w-8 place-content-center\">\n<svg aria-hidden=\"true\" class=\"size-4\" fill=\"currentColor\" viewbox=\"0 0 16 16\" xmlns=\"http://www.w3.org/2000/svg\">\n<path clip-rule=\"evenodd\" d=\"M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z\" fill-rule=\"evenodd\"></path>\n</svg>\n</span>\n</div>\n<datalist id=\"HeadlineList\" name=\"Headline\">\n<option value=\"JM\">John Mayer</option>\n<option value=\"SRV\">Stevie Ray Vaughn</option>\n<option value=\"JH\">Jimi Hendrix</option>\n<option value=\"BBK\">B.B King</option>\n<option value=\"AK\">Albert King</option>\n<option value=\"BG\">Buddy Guy</option>\n<option value=\"EC\">Eric Clapton</option>\n</datalist>\n</label>\n</div>",
