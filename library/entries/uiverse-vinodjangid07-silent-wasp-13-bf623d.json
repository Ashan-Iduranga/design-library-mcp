pt:hover {\n  background-color: rgb(0, 0, 0);\n}\n.reject:hover {\n  background-color: #ddd;\n}\n.exit-button {\n  position: absolute;\n  top: 17px;\n  right: 17px;\n  width: 20px;\n  height: 20px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background-color: transparent;\n  border: none;\n  border-radius: 5px;\n  cursor: pointer;\n}\n.exit-button:hover {\n  background-color: #ddd;\n  color: white;\n}\n.svgIconCross {\n  height: 10px;\n}\n\n</style>",
