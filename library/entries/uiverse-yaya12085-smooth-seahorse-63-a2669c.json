\n}\n\n.action button:hover {\n  height: 100%;\n  margin-right: 0;\n}\n\n.action button:active {\n  background-color: #4dec48;\n}\n\n@keyframes appear {\n  from {\n    transform: scale(0.98);\n  }\n\n  to {\n    transform: scale(1);\n  }\n}\n</style>",
