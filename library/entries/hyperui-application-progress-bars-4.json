  "code": "<div class=\"mx-auto flex max-w-3xl flex-wrap gap-8 p-6\">\n<div class=\"text-center\">\n<div aria-labelledby=\"LoadingCircleLabel\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"25\" class=\"relative mx-auto size-32\" role=\"progressbar\">\n<svg aria-hidden=\"true\" class=\"size-full\" viewbox=\"0 0 100 100\">\n<circle class=\"text-gray-200\" cx=\"50\" cy=\"50\" fill=\"none\" r=\"45\" stroke=\"currentColor\" stroke-width=\"8\"></circle>\n<circle class=\"origin-center text-blue-600\" cx=\"50\" cy=\"50\" fill=\"none\" r=\"45\" stroke=\"currentColor\" stroke-dasharray=\"70.7 282.7\" stroke-linecap=\"round\" stroke-width=\"8\" style=\"transform: rotate(-90deg)\"></circle>\n</svg>\n<div class=\"absolute inset-0 grid place-content-center\">\n<span class=\"text-xl font-semibold text-gray-900\">25%</span>\n</div>\n</div>\n<p class=\"mt-2 text-sm text-gray-700\" id=\"LoadingCircleLabel\">Loading</p>\n</div>\n<div class=\"text-center\">\n<div aria-labelledby=\"NearlyDoneCircleLabel\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"75\" class=\"relative mx-auto size-32\" role=\"progressbar\">\n<svg aria-hidden=\"true\" class=\"size-full\" viewbox=\"0 0 100 100\">\n<circle class=\"text-gray-200\" cx=\"50\" cy=\"50\" fill=\"none\" r=\"45\" stroke=\"currentColor\" stroke-width=\"8\"></circle>\n<circle class=\"origin-center text-green-600\" cx=\"50\" cy=\"50\" fill=\"none\" r=\"45\" stroke=\"currentColor\" stroke-dasharray=\"212.1 282.7\" stroke-linecap=\"round\" stroke-width=\"8\" style=\"transform: rotate(-90deg)\"></circle>\n</svg>\n<div class=\"absolute inset-0 grid place-content-center\">\n<span class=\"text-xl font-semibold text-gray-900\">75%</span>\n</div>\n</div>\n<p class=\"mt-2 text-sm text-gray-700\" id=\"NearlyDoneCircleLabel\">Nearly done</p>\n</div>\n</div>",
