eight: 600;\n  cursor: pointer;\n  transition: all 1s ease-in-out;\n}\n\nform button:hover {\n  background-color: #005ce6;\n}\n\n.form-footer {\n  background-color: #e0ecfb;\n  padding: 16px;\n  font-size: 1rem;\n  text-align: center;\n}\n\n.form-footer a {\n  font-weight: bolder;\n  color: #0066ff;\n  transition: all 3s ease-in-out;\n}\n\n.form-footer a:hover {\n  color: #005ce6;\n}\n\n</style>",
