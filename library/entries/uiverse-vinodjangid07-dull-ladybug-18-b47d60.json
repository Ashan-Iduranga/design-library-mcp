\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: none;\n  border-radius: 8px;\n  cursor: pointer;\n  transition: all 0.3s;\n}\n.IconContainer {\n  width: 40px;\n  height: 40px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  position: relative;\n}\n.IconContainer svg {\n  width: 40%;\n  z-index: 3;\n}\n.box-top {\n  transition: all 0.3s;\n}\n.text {\n  width: 70px;\n  height: 100%;\n  font-size: 13px;\n  color: #6a8ef6;\n  display: flex;\n  align-items: center;\n  justify-content: flex-start;\n  font-weight: 600;\n}\n.reward-btn:hover .IconContainer .box-top {\n  transform: translateY(-5px);\n}\n.reward-btn:hover {\n  background-color: #202531;\n}\n.reward-btn:hover .coin {\n  transform: translateY(-5px);\n  transition-delay: 0.2s;\n}\n.coin {\n  width: 25%;\n  height: 25%;\n  background-color: #e4d61a;\n  position: absolute;\n  border-radius: 50%;\n  transition: all 0.3s;\n  z-index: 1;\n  border: 2px solid #ffe956;\n  margin-top: 4px;\n}\n\n</style>",
