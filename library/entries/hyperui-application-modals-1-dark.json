  "code": "<div class=\"p-6\">\n<button class=\"rounded border border-gray-300 bg-gray-100 px-3 py-1.5 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-800 dark:text-white\" data-modal-open=\"\">\n      Open\n    </button>\n<dialog aria-describedby=\"modalDescription\" aria-labelledby=\"modalTitle\" class=\"m-auto max-w-xl rounded-lg bg-white p-6 shadow-lg backdrop:bg-black/50 dark:bg-gray-900 dark:backdrop:bg-white/50\" closedby=\"any\">\n<div class=\"flex flex-col gap-4\">\n<h2 class=\"text-xl font-bold text-gray-900 sm:text-2xl dark:text-white\" id=\"modalTitle\">\n          Modal Title\n        </h2>\n<p class=\"text-pretty text-gray-700 dark:text-gray-200\" id=\"modalDescription\">\n          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque euismod, nisi eu\n          consectetur. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\n        </p>\n</div>\n</dialog>\n<script>\n      const modalEl = document.querySelector('dialog')\n      const openButtonEl = document.querySelector('[data-modal-open]')\n\n      openButtonEl.addEventListener('click', () => modalEl.showModal())\n\n      document.querySelectorAll('[data-modal-close]').forEach((buttonEl) => {\n        buttonEl.addEventListener('click', () => modalEl.close())\n      })\n    </script>\n</div>",
