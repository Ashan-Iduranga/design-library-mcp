ion: .3s cubic-bezier(.6,.4,0,1);\n}\n\n.card > strong {\n  display: block;\n  font-size: 1.4rem;\n  letter-spacing: -.035em;\n}\n\n.card span {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  color: var(--hover-text);\n  border-radius: 5px;\n  font-weight: bold;\n  top: 100%;\n  transition: all .3s cubic-bezier(.6,.4,0,1);\n}\n\n.card:hover span {\n  top: 0;\n  font-size: 1.2em;\n}\n\n.card:hover {\n  background: var(--hover-bg);\n}\n\n.card:hover>div,.card:hover>strong {\n  opacity: 0;\n}\n</style>",
