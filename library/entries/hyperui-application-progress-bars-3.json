  "code": "<div class=\"mx-auto max-w-md space-y-6 p-6\">\n<div aria-labelledby=\"DownloadLabel\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"25\" role=\"progressbar\">\n<p class=\"text-xs font-medium tracking-wide text-gray-700 uppercase\" id=\"DownloadLabel\">\n        Download\n      </p>\n<div class=\"mt-2 h-1 w-full bg-gray-200\">\n<div class=\"h-full bg-blue-600\" style=\"width: 25%\"></div>\n</div>\n<p class=\"mt-2 text-xs text-gray-700\">1.2 of 3.8 MB</p>\n</div>\n<div aria-labelledby=\"FileConversionLabel\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"75\" role=\"progressbar\">\n<p class=\"text-xs font-medium tracking-wide text-gray-700 uppercase\" id=\"FileConversionLabel\">\n        File Conversion\n      </p>\n<div class=\"mt-2 h-1 w-full bg-gray-200\">\n<div class=\"h-full bg-blue-600\" style=\"width: 75%\"></div>\n</div>\n<p class=\"mt-2 text-xs text-gray-700\">3/4 files done</p>\n</div>\n<div aria-labelledby=\"FileSyncLabel\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"100\" role=\"progressbar\">\n<p class=\"text-xs font-medium tracking-wide text-gray-700 uppercase\" id=\"FileSyncLabel\">\n        File Sync\n      </p>\n<div class=\"mt-2 h-1 w-full bg-gray-200\">\n<div class=\"h-full bg-green-600\" style=\"width: 100%\"></div>\n</div>\n<p class=\"mt-2 text-xs text-gray-700\">Completed</p>\n</div>\n</div>",
