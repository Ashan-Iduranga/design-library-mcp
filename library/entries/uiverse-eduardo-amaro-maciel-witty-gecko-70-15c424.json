  "code": "<div class=\"container\">\n  <div class=\"card\">\n    <div class=\"face back\">\n      <div class=\"content\">\n        <span class=\"stars\"></span>\n        <b class=\"desc\">Hello</b>\n        <p class=\"desc\">\n          Lorem Ipsum is simply dummy text of the printing and typesetting industry.\n        </p>\n      </div>\n    </div>\n    <div class=\"face front\">\n      <b>Hover</b>\n    </div>\n  </div>\n</div>\n<style>\n/* From Uiverse.io by eduardo-amaro-maciel - Tags: card, hover, rainbow */\n.container {\n  margin: 0 auto;\n}\n\n.card {\n  position: relative;\n  width: 200px;\n  height: 300px;\n  margin: 0 auto;\n  background: #000;\n  border-radius: 15px;\n  box-shadow: 0 15px 60px rgba(0, 0, 0, 0.5);\n}\n\n.face {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n\n.face.back {\n  box-sizing: border-box;\n  padding: 20px;\n}\n\n.face.back b {\n  margin: 0;\n  padding: 0;\n}\n\n.face.back .desc {\n  background-color: #eee;\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.face.front {\n  transition: 0.5s;\n}\n\n.face.front b {\n  margin: 0;\n  padding: 0;\n  font-size: 5.1em;\n  color: #fff;\n  transition: 0.5s;\n  text-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);\n  z-index: 10;\n}\n\n.card:hover .face.front {\n  height: 60px;\n}\n\n.card:hover .face.front b {\n  font-size: 2em;\n}\n\n.face.front {\n  background-color: #0cbaba;\n  border-radius: 15px;\n}\n</style>",
