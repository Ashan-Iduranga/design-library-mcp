  "code": "<div class=\"flex h-screen overflow-hidden bg-gray-50\">\n<input class=\"peer sr-only\" id=\"sidebar-toggle\" type=\"checkbox\"/>\n<label aria-hidden=\"true\" class=\"fixed inset-0 z-30 hidden bg-gray-900/50 peer-checked:block lg:hidden\" for=\"sidebar-toggle\"></label>\n<div class=\"fixed inset-y-0 start-0 z-40 flex w-64 -translate-x-full flex-col justify-between overflow-y-auto border-e border-gray-200 bg-white transition-transform duration-300 peer-checked:translate-x-0 lg:static lg:shrink-0 lg:translate-x-0 max-lg:rtl:translate-x-full\" id=\"dashboard-sidebar\">\n<div class=\"p-4\">\n<span class=\"grid h-12 w-32 place-content-center rounded-lg bg-gray-100 text-sm text-gray-600\">\n          Logo\n        </span>\n<nav aria-label=\"Dashboard\" class=\"mt-4\">\n<ul class=\"space-y-1\">\n<li>\n<a class=\"block rounded-lg px-4 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900\" href=\"#\">\n                Overview\n              </a>\n</li>\n<li>\n<a class=\"block rounded-lg px-4 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900\" href=\"#\">\n                Customers\n              </a>\n</li>\n<li>\n<a class=\"block rounded-lg px-4 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900\" href=\"#\">\n                Orders\n              </a>\n</li>\n<li>\n<a class=\"block rounded-lg px-4 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900\" href=\"#\">\n                Billing\n              </a>\n</li>\n<li>\n<a class=\"block rounded-lg bg-gray-100 px-4 py-2 text-sm font-medium text-gray-900\" href=\"#\">\n                Settings\n              </a>\n</li>\n</ul>\n</nav>\n</div>\n<div class=\"sticky inset-x-0 bottom-0 border-t border-gray-200\">\n<a class=\"flex items-center gap-2 bg-white p-4 hover:bg-gray-50 hover:transition-colors\" href=\"#\">\n<img alt=\"\" class=\"size-10 rounded-full object-cover\" src=\"https://images.unsplash.com/photo-1600486913747-55e5470d6f40?auto=format&amp;fit=crop&amp;q=80&amp;w=1160\"/>\n<p class=\"text-xs text-gray-900\">\n<strong class=\"block font-medium\">Priya Natarajan</strong>\n<span>priya@orbitly.com</span>\n</p>\n</a>\n</div>\n</div>\n<div class=\"flex flex-1 flex-col overflow-y-auto\">\n<header class=\"flex items-center justify-between border-b border-gray-200 bg-white px-6 py-4\">\n<div class=\"flex items-center gap-4\">\n<label aria-controls=\"dashboard-sidebar\" aria-expanded=\"false\" class=\"cursor-pointer rounded-md p-2 text-gray-600 transition-colors peer-focus-visible:ring-2 peer-focus-visible:ring-gray-900 peer-focus-visible:ring-offset-2 hover:bg-gray-100 lg:hidden\" for=\"sidebar-toggle\" id=\"sidebar-toggle-label\">\n<span class=\"sr-only\">Toggle menu</span>\n<svg aria-hidden=\"true\" class=\"size-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M4 6h16M4 12h16M4 18h16\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n</svg>\n</label>\n<h1 class=\"text-lg font-semibold text-gray-900\">Settings</h1>\n</div>\n<button class=\"rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-gray-800\" form=\"account-settings-form\" type=\"submit\">\n          Save changes\n        </button>\n</header>\n<main class=\"flex-1 space-y-6 p-6\">\n<form class=\"rounded-lg border border-gray-200 bg-white p-6\" id=\"account-settings-form\">\n<h2 class=\"text-sm font-medium text-gray-900\">Profile</h2>\n<div class=\"mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2\">\n<div>\n<label class=\"block text-sm font-medium text-gray-700\" for=\"full-name\">\n                Full name\n              </label>\n<input class=\"mt-1 w-full rounded-md border-gray-200 text-sm text-gray-900 shadow-xs\" id=\"full-name\" type=\"text\" value=\"Priya Natarajan\"/>\n</div>\n<div>\n<label class=\"block text-sm font-medium text-gray-700\" for=\"email-address\">\n                Email address\n              </label>\n<input class=\"mt-1 w-full rounded-md border-gray-200 text-sm text-gray-900 shadow-xs\" id=\"email-address\" type=\"email\" value=\"priya@orbitly.com\"/>\n</div>\n<div class=\"sm:col-span-2\">\n<label class=\"block text-sm font-medium text-gray-700\" for=\"team-name\">\n                Team name\n              </label>\n<input class=\"mt-1 w-full rounded-md border-gray-200 text-sm text-gray-900 shadow-xs\" id=\"team-name\" type=\"text\" value=\"Orbitly\"/>\n</div>\n</div>\n</form>\n<div class=\"rounded-lg border border-gray-200 bg-white p-6\">\n<h2 class=\"text-sm font-medium text-gray-900\">Notifications</h2>\n<ul class=\"mt-4 divide-y divide-gray-200\">\n<li class=\"flex items-center justify-between gap-4 py-3 first:pt-0 last:pb-0\">\n<div>\n<p class=\"text-sm font-medium text-gray-900\">Email notifications</p>\n<p class=\"text-xs text-gray-600\">Get notified when a customer places an order.</p>\n</div>\n<label class=\"relative inline-flex h-6 w-11 shrink-0 cursor-pointer items-center rounded-full bg-gray-200 transition has-checked:bg-indigo-600\" for=\"email-notifications-toggle\">\n<input checked=\"\" class=\"peer sr-only\" id=\"email-notifications-toggle\" type=\"checkbox\"/>\n<span class=\"size-4 translate-x-1 rounded-full bg-white transition peer-checked:translate-x-6 rtl:-translate-x-1 rtl:peer-checked:-translate-x-6\"></span>\n</label>\n</li>\n<li class=\"flex items-center justify-between gap-4 py-3 first:pt-0 last:pb-0\">\n<div>\n<p class=\"text-sm font-medium text-gray-900\">Product updates</p>\n<p class=\"text-xs text-gray-600\">Occasional emails about new features.</p>\n</div>\n<label class=\"relative inline-flex h-6 w-11 shrink-0 cursor-pointer items-center rounded-full bg-gray-200 transition has-checked:bg-indigo-600\" for=\"product-updates-toggle\">\n<input class=\"peer sr-only\" id=\"product-updates-toggle\" type=\"checkbox\"/>\n<span class=\"size-4 translate-x-1 rounded-full bg-white transition peer-checked:translate-x-6 rtl:-translate-x-1 rtl:peer-checked:-translate-x-6\"></span>\n</label>\n</li>\n<li class=\"flex items-center justify-between gap-4 py-3 first:pt-0 last:pb-0\">\n<div>\n<p class=\"text-sm font-medium text-gray-900\">Weekly summary</p>\n<p class=\"text-xs text-gray-600\">A digest of revenue and orders every Monday.</p>\n</div>\n<label class=\"relative inline-flex h-6 w-11 shrink-0 cursor-pointer items-center rounded-full bg-gray-200 transition has-checked:bg-indigo-600\" for=\"weekly-summary-toggle\">\n<input checked=\"\" class=\"peer sr-only\" id=\"weekly-summary-toggle\" type=\"checkbox\"/>\n<span class=\"size-4 translate-x-1 rounded-full bg-white transition peer-checked:translate-x-6 rtl:-translate-x-1 rtl:peer-checked:-translate-x-6\"></span>\n</label>\n</li>\n</ul>\n</div>\n<div class=\"rounded-lg border border-red-200 bg-white p-6\">\n<h2 class=\"text-sm font-medium text-gray-900\">Danger zone</h2>\n<p class=\"mt-2 text-sm text-gray-600\">\n            Deleting your team removes all customers, orders, and billing history. This cannot be\n            undone.\n          </p>\n<button class=\"mt-4 inline-block rounded-md border border-red-200 px-4 py-2 text-sm font-medium text-red-700 transition hover:bg-red-50\" type=\"button\">\n            Delete team\n          </button>\n</div>\n</main>\n</div>\n<script>\n      const sidebarToggleCheckbox = document.getElementById('sidebar-toggle')\n      const sidebarToggleLabel = document.getElementById('sidebar-toggle-label')\n\n      sidebarToggleCheckbox.addEventListener('change', () => {\n        sidebarToggleLabel.setAttribute('aria-expanded', String(sidebarToggleCheckbox.checked))\n      })\n    </script>\n</div>",
