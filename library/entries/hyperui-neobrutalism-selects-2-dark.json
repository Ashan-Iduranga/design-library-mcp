  "code": "<div class=\"mx-auto max-w-xs p-6\">\n<label class=\"text-black dark:text-white\" for=\"Headline\">\n<span class=\"text-sm font-semibold\"> Headliner </span>\n<select class=\"mt-0.5 w-full border-2 border-black bg-white placeholder-black shadow-[4px_4px_0_0] shadow-black focus:ring-2 focus:ring-yellow-300 sm:text-sm dark:border-white dark:bg-gray-900 dark:placeholder-white dark:shadow-white dark:focus:ring-yellow-600\" id=\"Headline\" name=\"Headline\">\n<option value=\"\">Please select</option>\n<optgroup label=\"A\">\n<option value=\"AK\">Albert King</option>\n</optgroup>\n<optgroup label=\"B\">\n<option value=\"BBK\">B.B King</option>\n<option value=\"BG\">Buddy Guy</option>\n</optgroup>\n<optgroup label=\"E\">\n<option value=\"EC\">Eric Clapton</option>\n</optgroup>\n<optgroup label=\"J\">\n<option value=\"JM\">John Mayer</option>\n<option value=\"JH\">Jimi Hendrix</option>\n</optgroup>\n<optgroup label=\"S\">\n<option value=\"SRV\">Stevie Ray Vaughn</option>\n</optgroup>\n</select>\n</label>\n</div>",
