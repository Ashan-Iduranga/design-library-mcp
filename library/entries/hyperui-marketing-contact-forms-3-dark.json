  "code": "<div class=\"p-6\">\n<form action=\"#\" class=\"mx-auto max-w-md space-y-4 rounded-lg border border-gray-300 bg-gray-100 p-6 dark:border-gray-600 dark:bg-gray-800\">\n<div>\n<label class=\"block text-sm font-medium text-gray-900 dark:text-white\" for=\"name\">\n          Name\n        </label>\n<input class=\"mt-1 w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-white\" id=\"name\" placeholder=\"Your name\" type=\"text\"/>\n</div>\n<div>\n<label class=\"block text-sm font-medium text-gray-900 dark:text-white\" for=\"email\">\n          Email\n        </label>\n<input class=\"mt-1 w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-white\" id=\"email\" placeholder=\"Your email\" type=\"email\"/>\n</div>\n<fieldset>\n<legend class=\"block text-sm font-medium text-gray-900 dark:text-white\">Inquiry</legend>\n<div class=\"mt-2 space-y-2\">\n<div class=\"flex items-center gap-2\">\n<input class=\"size-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900 dark:text-white\" id=\"general-inquiry\" name=\"inquiry-type\" type=\"checkbox\" value=\"general-inquiry\"/>\n<label class=\"block text-sm text-gray-900 dark:text-white\" for=\"general-inquiry\">\n              General Inquiry\n            </label>\n</div>\n<div class=\"flex items-center gap-2\">\n<input class=\"size-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900 dark:text-white\" id=\"support\" name=\"inquiry-type\" type=\"checkbox\" value=\"support\"/>\n<label class=\"block text-sm text-gray-900 dark:text-white\" for=\"support\">Support</label>\n</div>\n<div class=\"flex items-center gap-2\">\n<input class=\"size-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900 dark:text-white\" id=\"feedback\" name=\"inquiry-type\" type=\"checkbox\" value=\"feedback\"/>\n<label class=\"block text-sm text-gray-900 dark:text-white\" for=\"feedback\">Feedback</label>\n</div>\n<div class=\"flex items-center gap-2\">\n<input class=\"size-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900 dark:text-white\" id=\"other\" name=\"inquiry-type\" type=\"checkbox\" value=\"other\"/>\n<label class=\"block text-sm text-gray-900 dark:text-white\" for=\"other\">Other</label>\n</div>\n</div>\n</fieldset>\n<div>\n<label class=\"block text-sm font-medium text-gray-900 dark:text-white\" for=\"message\">\n          Message\n        </label>\n<textarea class=\"mt-1 w-full resize-none rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-white\" id=\"message\" placeholder=\"Your message\" rows=\"4\"></textarea>\n</div>\n<button class=\"block w-full rounded-lg border border-indigo-600 bg-indigo-600 px-12 py-3 text-sm font-medium text-white transition-colors hover:bg-transparent hover:text-indigo-600 dark:hover:bg-indigo-700 dark:hover:text-white\" type=\"submit\">\n        Send Message\n      </button>\n</form>\n</div>",
