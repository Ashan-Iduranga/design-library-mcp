px;\n  background: linear-gradient(-45deg, gray 0%, lightgray 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  transition: all .3s;\n}\n\nbutton:active i {\n  transform: scale(.9);\n  transition: all .3s;\n}\n\n.svg {\n  width: 25px;\n  height: 60px;\n  border-style: none;\n  align-items: center;\n}\n</style>",
