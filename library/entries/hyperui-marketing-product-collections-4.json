  "code": "<section>\n<div class=\"mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8\">\n<header>\n<h2 class=\"text-xl font-bold text-gray-900 sm:text-3xl\">Product Collection</h2>\n<p class=\"mt-4 max-w-md text-gray-500\">\n            Lorem ipsum, dolor sit amet consectetur adipisicing elit. Itaque praesentium cumque iure\n            dicta incidunt est ipsam, officia dolor fugit natus?\n          </p>\n</header>\n<div class=\"mt-8 block lg:hidden\">\n<button class=\"flex cursor-pointer items-center gap-2 border-b border-gray-400 pb-1 text-gray-900 transition hover:border-gray-600\">\n<span class=\"text-sm font-medium\"> Filters &amp; Sorting </span>\n<svg aria-hidden=\"true\" class=\"size-4 rtl:rotate-180\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M8.25 4.5l7.5 7.5-7.5 7.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n</svg>\n</button>\n</div>\n<div class=\"mt-4 lg:mt-8 lg:grid lg:grid-cols-4 lg:items-start lg:gap-8\">\n<div class=\"hidden space-y-4 lg:block\">\n<div>\n<label class=\"block text-xs font-medium text-gray-700\" for=\"SortBy\"> Sort By </label>\n<select class=\"mt-1 rounded-sm border-gray-300 text-sm\" id=\"SortBy\">\n<option>Sort By</option>\n<option value=\"Title, DESC\">Title, DESC</option>\n<option value=\"Title, ASC\">Title, ASC</option>\n<option value=\"Price, DESC\">Price, DESC</option>\n<option value=\"Price, ASC\">Price, ASC</option>\n</select>\n</div>\n<div>\n<p class=\"block text-xs font-medium text-gray-700\">Filters</p>\n<div class=\"mt-1 space-y-2\">\n<details class=\"overflow-hidden rounded-sm border border-gray-300 [&amp;_summary::-webkit-details-marker]:hidden\">\n<summary class=\"flex cursor-pointer items-center justify-between gap-2 p-4 text-gray-900 transition\">\n<span class=\"text-sm font-medium\"> Availability </span>\n<span class=\"transition group-open:-rotate-180\">\n<svg aria-hidden=\"true\" class=\"size-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M19.5 8.25l-7.5 7.5-7.5-7.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n</svg>\n</span>\n</summary>\n<div class=\"border-t border-gray-200 bg-white\">\n<header class=\"flex items-center justify-between p-4\">\n<span class=\"text-sm text-gray-700\"> 0 Selected </span>\n<button class=\"text-sm text-gray-900 underline underline-offset-4\" type=\"button\">\n                        Reset\n                      </button>\n</header>\n<ul class=\"space-y-1 border-t border-gray-200 p-4\">\n<li>\n<label class=\"inline-flex items-center gap-2\" for=\"FilterInStock\">\n<input class=\"size-5 rounded-sm border-gray-300 shadow-sm\" id=\"FilterInStock\" type=\"checkbox\"/>\n<span class=\"text-sm font-medium text-gray-700\"> In Stock (5+) </span>\n</label>\n</li>\n<li>\n<label class=\"inline-flex items-center gap-2\" for=\"FilterPreOrder\">\n<input class=\"size-5 rounded-sm border-gray-300 shadow-sm\" id=\"FilterPreOrder\" type=\"checkbox\"/>\n<span class=\"text-sm font-medium text-gray-700\"> Pre Order (3+) </span>\n</label>\n</li>\n<li>\n<label class=\"inline-flex items-center gap-2\" for=\"FilterOutOfStock\">\n<input class=\"size-5 rounded-sm border-gray-300 shadow-sm\" id=\"FilterOutOfStock\" type=\"checkbox\"/>\n<span class=\"text-sm font-medium text-gray-700\">\n                            Out of Stock (10+)\n                          </span>\n</label>\n</li>\n</ul>\n</div>\n</details>\n<details class=\"overflow-hidden rounded-sm border border-gray-300 [&amp;_summary::-webkit-details-marker]:hidden\">\n<summary class=\"flex cursor-pointer items-center justify-between gap-2 p-4 text-gray-900 transition\">\n<span class=\"text-sm font-medium\"> Price </span>\n<span class=\"transition group-open:-rotate-180\">\n<svg aria-hidden=\"true\" class=\"size-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M19.5 8.25l-7.5 7.5-7.5-7.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n</svg>\n</span>\n</summary>\n<div class=\"border-t border-gray-200 bg-white\">\n<header class=\"flex items-center justify-between p-4\">\n<span class=\"text-sm text-gray-700\"> The highest price is $600 </span>\n<button class=\"text-sm text-gray-900 underline underline-offset-4\" type=\"button\">\n                        Reset\n                      </button>\n</header>\n<div class=\"border-t border-gray-200 p-4\">\n<div class=\"flex justify-between gap-4\">\n<label class=\"flex items-center gap-2\" for=\"FilterPriceFrom\">\n<span class=\"text-sm text-gray-600\">$</span>\n<input class=\"w-full rounded-md border-gray-200 shadow-xs sm:text-sm\" id=\"FilterPriceFrom\" placeholder=\"From\" type=\"number\"/>\n</label>\n<label class=\"flex items-center gap-2\" for=\"FilterPriceTo\">\n<span class=\"text-sm text-gray-600\">$</span>\n<input class=\"w-full rounded-md border-gray-200 shadow-xs sm:text-sm\" id=\"FilterPriceTo\" placeholder=\"To\" type=\"number\"/>\n</label>\n</div>\n</div>\n</div>\n</details>\n<details class=\"overflow-hidden rounded-sm border border-gray-300 [&amp;_summary::-webkit-details-marker]:hidden\">\n<summary class=\"flex cursor-pointer items-center justify-between gap-2 p-4 text-gray-900 transition\">\n<span class=\"text-sm font-medium\"> Colors </span>\n<span class=\"transition group-open:-rotate-180\">\n<svg aria-hidden=\"true\" class=\"size-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M19.5 8.25l-7.5 7.5-7.5-7.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n</svg>\n</span>\n</summary>\n<div class=\"border-t border-gray-200 bg-white\">\n<header class=\"flex items-center justify-between p-4\">\n<span class=\"text-sm text-gray-700\"> 0 Selected </span>\n<button class=\"text-sm text-gray-900 underline underline-offset-4\" type=\"button\">\n                        Reset\n                      </button>\n</header>\n<ul class=\"space-y-1 border-t border-gray-200 p-4\">\n<li>\n<label class=\"inline-flex items-center gap-2\" for=\"FilterRed\">\n<input class=\"size-5 rounded-sm border-gray-300 shadow-sm\" id=\"FilterRed\" type=\"checkbox\"/>\n<span class=\"text-sm font-medium text-gray-700\"> Red </span>\n</label>\n</li>\n<li>\n<label class=\"inline-flex items-center gap-2\" for=\"FilterBlue\">\n<input class=\"size-5 rounded-sm border-gray-300 shadow-sm\" id=\"FilterBlue\" type=\"checkbox\"/>\n<span class=\"text-sm font-medium text-gray-700\"> Blue </span>\n</label>\n</li>\n<li>\n<label class=\"inline-flex items-center gap-2\" for=\"FilterGreen\">\n<input class=\"size-5 rounded-sm border-gray-300 shadow-sm\" id=\"FilterGreen\" type=\"checkbox\"/>\n<span class=\"text-sm font-medium text-gray-700\"> Green </span>\n</label>\n</li>\n<li>\n<label class=\"inline-flex items-center gap-2\" for=\"FilterOrange\">\n<input class=\"size-5 rounded-sm border-gray-300 shadow-sm\" id=\"FilterOrange\" type=\"checkbox\"/>\n<span class=\"text-sm font-medium text-gray-700\"> Orange </span>\n</label>\n</li>\n<li>\n<label class=\"inline-flex items-center gap-2\" for=\"FilterPurple\">\n<input class=\"size-5 rounded-sm border-gray-300 shadow-sm\" id=\"FilterPurple\" type=\"checkbox\"/>\n<span class=\"text-sm font-medium text-gray-700\"> Purple </span>\n</label>\n</li>\n<li>\n<label class=\"inline-flex items-center gap-2\" for=\"FilterTeal\">\n<input class=\"size-5 rounded-sm border-gray-300 shadow-sm\" id=\"FilterTeal\" type=\"checkbox\"/>\n<span class=\"text-sm font-medium text-gray-700\"> Teal </span>\n</label>\n</li>\n</ul>\n</div>\n</details>\n</div>\n</div>\n</div>\n<div class=\"lg:col-span-3\">\n<ul class=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n<li>\n<a class=\"group block overflow-hidden\" href=\"#\">\n<img alt=\"\" class=\"h-87.5 w-full object-cover transition duration-500 group-hover:scale-105 sm:h-112.5\" src=\"https://images.unsplash.com/photo-1523381210434-271e8be1f52b?auto=format&amp;fit=crop&amp;q=80&amp;w=1160\"/>\n<div class=\"relative bg-white pt-3\">\n<h3 class=\"text-xs text-gray-700 group-hover:underline group-hover:underline-offset-4\">\n                      Basic Tee\n                    </h3>\n<p class=\"mt-2\">\n<span class=\"sr-only\"> Regular Price </span>\n<span class=\"tracking-wider text-gray-900\"> £24.00 GBP </span>\n</p>\n</div>\n</a>\n</li>\n<li>\n<a class=\"group block overflow-hidden\" href=\"#\">\n<img alt=\"\" class=\"h-87.5 w-full object-cover transition duration-500 group-hover:scale-105 sm:h-112.5\" src=\"https://images.unsplash.com/photo-1523381210434-271e8be1f52b?auto=format&amp;fit=crop&amp;q=80&amp;w=1160\"/>\n<div class=\"relative bg-white pt-3\">\n<h3 class=\"text-xs text-gray-700 group-hover:underline group-hover:underline-offset-4\">\n                      Basic Tee\n                    </h3>\n<p class=\"mt-2\">\n<span class=\"sr-only\"> Regular Price </span>\n<span class=\"tracking-wider text-gray-900\"> £24.00 GBP </span>\n</p>\n</div>\n</a>\n</li>\n<li>\n<a class=\"group block overflow-hidden\" href=\"#\">\n<img alt=\"\" class=\"h-87.5 w-full object-cover transition duration-500 group-hover:scale-105 sm:h-112.5\" src=\"https://images.unsplash.com/photo-1523381210434-271e8be1f52b?auto=format&amp;fit=crop&amp;q=80&amp;w=1160\"/>\n<div class=\"relative bg-white pt-3\">\n<h3 class=\"text-xs text-gray-700 group-hover:underline group-hover:underline-offset-4\">\n                      Basic Tee\n                    </h3>\n<p class=\"mt-2\">\n<span class=\"sr-only\"> Regular Price </span>\n<span class=\"tracking-wider text-gray-900\"> £24.00 GBP </span>\n</p>\n</div>\n</a>\n</li>\n</ul>\n</div>\n</div>\n</div>\n</section>",
