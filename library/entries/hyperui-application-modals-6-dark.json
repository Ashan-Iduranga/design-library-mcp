  "notes": "Original file: https://github.com/markmead/hyperui/blob/main/public/examples/application/modals/6-dark.html",
  "code": "<div class=\"p-6\">\n<button class=\"rounded border border-gray-300 bg-gray-100 px-3 py-1.5 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-800 dark:text-white\" data-modal-open=\"\">\n      Open\n    </button>\n<dialog aria-describedby=\"modalDescription\" aria-labelledby=\"modalTitle\" class=\"m-auto max-w-xl rounded-lg bg-white p-6 shadow-lg backdrop:bg-black/50 dark:bg-gray-900 dark:backdrop:bg-white/50\" closedby=\"any\">\n<div class=\"flex flex-col gap-4\">\n<div class=\"flex items-start justify-between\">\n<h2 class=\"text-xl font-bold text-gray-900 sm:text-2xl dark:text-white\" id=\"modalTitle\">\n            Modal Title\n          </h2>\n<button aria-label=\"Close\" class=\"-me-4 -mt-4 rounded-full p-2 text-gray-600 transition-colors hover:bg-gray-50 hover:text-gray-900 focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2 focus:ring-offset-white focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2 focus-visible:ring-offset-white focus-visible:outline-none dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-gray-300 dark:focus:ring-indigo-300 dark:focus:ring-offset-gray-900 dark:focus-visible:ring-indigo-300 dark:focus-visible:ring-offset-gray-900\" data-modal-close=\"\" type=\"button\">\n<svg aria-hidden=\"true\" class=\"size-5\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M6 18L18 6M6 6l12 12\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"></path>\n</svg>\n</button>\n</div>\n<p class=\"text-pretty text-gray-700 dark:text-gray-200\" id=\"modalDescription\">\n          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque euismod, nisi eu\n          consectetur. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\n        </p>\n<label class=\"block\" for=\"Confirm\">\n<span class=\"text-sm font-medium text-gray-700 dark:text-gray-200\">\n            Please type \"Confirm\" to complete action\n          </span>\n<input class=\"mt-0.5 w-full rounded border-gray-300 bg-white text-gray-900 shadow-sm sm:text-sm dark:border-gray-600 dark:bg-gray-900 dark:text-white\" id=\"Confirm\" type=\"text\"/>\n</label>\n<div class=\"flex justify-end gap-2\">\n<button class=\"rounded bg-gray-100 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-200 focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2 focus:ring-offset-white focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2 focus-visible:ring-offset-white focus-visible:outline-none dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700 dark:focus:ring-indigo-300 dark:focus:ring-offset-gray-900 dark:focus-visible:ring-indigo-300 dark:focus-visible:ring-offset-gray-900\" data-modal-close=\"\" type=\"button\">\n            Cancel\n          </button>\n<button class=\"rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-700 focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2 focus:ring-offset-white focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2 focus-visible:ring-offset-white focus-visible:outline-none dark:bg-blue-300 dark:text-gray-900 dark:hover:bg-blue-200 dark:focus:ring-indigo-300 dark:focus:ring-offset-gray-900 dark:focus-visible:ring-indigo-300 dark:focus-visible:ring-offset-gray-900\" data-modal-close=\"\" type=\"button\">\n            Done\n          </button>\n</div>\n</div>\n</dialog>\n<script>\n      const modalEl = document.querySelector('dialog')\n      const openButtonEl = document.querySelector('[data-modal-open]')\n\n      openButtonEl.addEventListener('click', () => modalEl.showModal())\n\n      document.querySelectorAll('[data-modal-close]').forEach((buttonEl) => {\n        buttonEl.addEventListener('click', () => modalEl.close())\n      })\n    </script>\n</div>",
