  "code": "<div class=\"p-6\">\n<form action=\"#\" class=\"mx-auto max-w-md space-y-4 rounded-lg border border-gray-300 bg-gray-100 p-6\">\n<div>\n<label class=\"block text-sm font-medium text-gray-900\" for=\"name\">Name</label>\n<input class=\"mt-1 w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none\" id=\"name\" placeholder=\"Your name\" type=\"text\"/>\n</div>\n<div>\n<label class=\"block text-sm font-medium text-gray-900\" for=\"email\">Email</label>\n<input class=\"mt-1 w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none\" id=\"email\" placeholder=\"Your email\" type=\"email\"/>\n</div>\n<div>\n<label class=\"block text-sm font-medium text-gray-900\" for=\"message\">Message</label>\n<textarea class=\"mt-1 w-full resize-none rounded-lg border-gray-300 focus:border-indigo-500 focus:outline-none\" id=\"message\" placeholder=\"Your message\" rows=\"4\"></textarea>\n</div>\n<button class=\"block w-full rounded-lg border border-indigo-600 bg-indigo-600 px-12 py-3 text-sm font-medium text-white transition-colors hover:bg-transparent hover:text-indigo-600\" type=\"submit\">\n        Send Message\n      </button>\n</form>\n</div>",
